# Admin Dashboard Environment Variables
# Copy to apps/admin/.env.local for local dev. On Vercel, set these in the
# project's Environment Variables settings.

# Base URL of the API. Used only for server-side/SSR fetches — browser requests
# go to the relative /api/* path, which next.config.js rewrites to this host.
# Keeping browser calls relative is what keeps auth cookies scoped to this
# app's own origin, so an admin session here cannot collide with a customer
# session on the storefront. Do not point browser-side authenticated fetches at
# an absolute cross-origin API URL.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Public base URL of the Cloudflare R2 bucket serving product images.
# REQUIRED AT BUILD TIME: next.config.js derives the image optimizer's allowed
# remote hosts from this at build, not at runtime. If it is unset when Vercel
# builds, every product image fails with an "unconfigured host" error even
# though the value is present at runtime. Set it as a build-time variable.
R2_PUBLIC_URL=

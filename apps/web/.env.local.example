# ============================================================================
# Web Storefront (apps/web) Environment Variables
# ============================================================================
# Copy to apps/web/.env.local for local dev.
# On Vercel, set these under the project's Settings → Environment Variables.
#
#   [REQUIRED]   — the app will not work correctly without it
#   [BUILD-TIME] — must exist when Vercel BUILDS, not just at runtime
#   [OPTIONAL]   — has a working default
#
# MINIMUM: NEXT_PUBLIC_API_URL
# ALSO REQUIRED IN PRODUCTION: R2_PUBLIC_URL (as a build-time variable)
#
# That is the complete list — this app reads only those two (plus NODE_ENV,
# which Next.js sets itself). Verified by grepping process.env across
# apps/web/src, next.config.js, and shared/.
# ============================================================================

# [REQUIRED] Base URL of the API, including /api/v1.
#
# Used ONLY for server-side/SSR fetches. Browser requests go to the relative
# /api/* path, which next.config.js rewrites to this host server-side.
#
# That indirection is load-bearing: because the browser only ever talks to this
# app's own origin, auth cookies stay host-only to it — which is what lets a
# customer session here and an admin session on the admin app coexist in one
# browser. Do NOT point browser-side authenticated fetch() calls at an absolute
# cross-origin API URL; that would put both apps in one cookie jar and break
# the isolation.
#
# WHERE: Render dashboard → your API web service → the service URL, with /api/v1
# appended. Format: https://<service>.onrender.com/api/v1
# Local dev uses the default below and needs no Vercel entry.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# NOT NEEDED — deliberately omitted:
#
#   NEXT_PUBLIC_RAZORPAY_KEY_ID — nothing reads it. Checkout receives the
#     Razorpay key from the API in the create-order response
#     (`data.data.razorpay.key`, see src/app/checkout/page.tsx), so the key
#     lives only in the server's RAZORPAY_KEY_ID. Setting it here does nothing.
#
#   NEXT_PUBLIC_STORE_NAME — nothing reads it. Store name comes from
#     Store.config.json via StoreConfigContext.
#
# Both were listed in this file previously and were misleading: they invited
# configuring values that have no effect.

# [BUILD-TIME] Public base URL of the Cloudflare R2 bucket serving product images.
#
# next.config.js derives the Next.js image optimizer's allowed remote hosts from
# this AT BUILD TIME. If it is missing when Vercel builds, every product image
# fails with an "unconfigured host" error even though the value is present at
# runtime — and the error looks unrelated to this variable. Set it as a
# build-time variable, not just a runtime one.
#
# WHERE: Cloudflare dashboard → R2 → your bucket → Settings → Public access.
# Use the r2.dev URL or your custom domain, with no trailing slash.
#
# This MUST be byte-identical to the server's R2_PUBLIC_URL. The server builds
# image URLs from its copy and this app allowlists hosts from its own; if they
# disagree, images resolve to a host the optimizer refuses to load.
#
# On Vercel: Settings → Environment Variables, and it must be available to the
# Build step, not only at runtime.
R2_PUBLIC_URL=

# ── Clerk authentication ────────────────────────────────────────────────────

# [REQUIRED, BUILD-TIME] Clerk publishable key. Public by design — it ships to
# the browser — but it is REQUIRED AT BUILD TIME: ClerkProvider throws during
# static generation without it, so `next build` fails outright rather than
# degrading. Set it as a build-time variable on Vercel, not runtime-only.
#
# WHERE: Clerk Dashboard → API Keys → Publishable key. Starts with pk_test_ or
# pk_live_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# [REQUIRED] Clerk secret key. SERVER-SIDE ONLY — never expose it to the client
# and never prefix it with NEXT_PUBLIC_.
#
# WHERE: Clerk Dashboard → API Keys → Secret key. Starts with sk_test_ or sk_live_.
CLERK_SECRET_KEY=

# [OPTIONAL] Where Clerk sends users to sign in / sign up. Read by @clerk/nextjs.
# Local routes on this app. Leave unset to use Clerk's hosted modal flow, which
# is what the current SignInButton/SignUpButton controls use.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=

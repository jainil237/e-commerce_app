# Server Environment Variables
# Copy to server/.env and fill in real values. Never commit the filled copy.

NODE_ENV=development
PORT=4000

# ── Database ────────────────────────────────────────────────────────────────
# Local dev: MySQL. Production: TiDB Serverless (MySQL wire-compatible, so the
# Prisma provider stays "mysql"). TiDB requires TLS — append its SSL params to
# the connection string exactly as TiDB's console provides them.
DATABASE_URL=mysql://root:password@localhost:3306/ecommerce_db

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-at-least-64-characters-long-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-at-least-64-characters-long-change-this

# ── Razorpay ────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=xxxx
RAZORPAY_WEBHOOK_SECRET=xxxx

# Set to "true" ONLY in local dev/test to bypass real Razorpay signature
# verification. Must be unset or false in production.
PAYMENTS_MOCK=

# ── Redis / BullMQ queue ────────────────────────────────────────────────────
# Production: Upstash Redis. BullMQ needs a TCP connection, so use Upstash's
# `rediss://` connection string (NOT the REST URL — ioredis cannot use REST).
# Leave empty in dev to run without a worker; queue producers will no-op.
REDIS_URL=

# ── SMTP (optional — email service no-ops if unset) ─────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourstore@gmail.com
SMTP_PASS=your-app-specific-password

# ── URLs ────────────────────────────────────────────────────────────────────
# In production these are the real deployed origins. The CORS allowlist is
# built from FRONTEND_URL + ADMIN_URL, so a wrong value here blocks the app.
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# The server's own public base URL. Used to build absolute URLs for locally
# stored uploads in dev. In production set it to the Render service URL.
SERVER_BASE_URL=http://localhost:4000

# ── Storage ─────────────────────────────────────────────────────────────────
# Production REQUIRES one cloud provider (R2 or Cloudinary) — the server
# refuses to boot with NODE_ENV=production and neither configured, because the
# local-disk fallback writes to an ephemeral filesystem on Render.
# In dev, leaving both blank falls back to local disk, which is fine.

# Cloudflare R2 (preferred — 10GB free, no egress fees)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL of the R2 bucket. Also needed at BUILD time by apps/web and
# apps/admin for Next.js image optimization — see their .env.local.example.
R2_PUBLIC_URL=

# Cloudinary (fallback if R2 is not configured)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ecommerce/products

# ── Logistics webhook ───────────────────────────────────────────────────────
LOGISTICS_WEBHOOK_SECRET=

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(uuid())
  name          String
  email         String          @unique
  phone         String          @unique
  passwordHash  String
  role          Role            @default(CUSTOMER)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  addresses     Address[]
  orders        Order[]
  refreshTokens RefreshToken[]
  wishlists     Wishlist[]
  couponUsages  CouponUsage[]
  rmaRequests   RMARequest[]
  auditLogs     OrderAuditLog[]

  @@index([email])
  @@index([phone])
}

model Address {
  id        String  @id @default(uuid())
  userId    String
  label     String  @default("Home")
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@index([userId])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  products    Product[]

  @@index([slug])
}

model Product {
  id                String             @id @default(uuid())
  name              String
  slug              String             @unique
  description       String             @db.Text
  price             Decimal            @db.Decimal(10, 2)
  mrp               Decimal            @db.Decimal(10, 2)
  stock             Int                @default(0)
  sku               String             @unique
  categoryId        String
  isActive          Boolean            @default(true)
  isFeatured        Boolean            @default(false)
  isReturnable      Boolean            @default(true)
  isReplaceable     Boolean            @default(true)
  returnWindow      Int                @default(7)
  weight            Float?
  tags              String?
  gstPercent        Float              @default(18)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  category          Category           @relation(fields: [categoryId], references: [id])
  images            ProductImage[]
  stockReservations StockReservation[]
  wishlists         Wishlist[]
  orderItems        OrderItem[]

  @@index([slug])
  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  altText   String?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Order {
  id                String          @id @default(uuid())
  orderNumber       String          @unique
  userId            String?
  addressId         String
  subtotal          Decimal         @db.Decimal(10, 2)
  shippingCharge    Decimal         @db.Decimal(10, 2)
  discount          Decimal         @default(0.00) @db.Decimal(10, 2)
  gstAmount         Decimal         @db.Decimal(10, 2)
  total             Decimal         @db.Decimal(10, 2)
  status            OrderStatus     @default(PENDING)
  paymentStatus     PaymentStatus   @default(PENDING)
  razorpayOrderId   String?
  razorpayPaymentId String?
  couponCode        String?
  notes             String?
  invoiceUrl        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  address           Address         @relation(fields: [addressId], references: [id])
  user              User?           @relation(fields: [userId], references: [id])
  shipping          Shipment?
  items             OrderItem[]
  rmaRequests       RMARequest[]
  auditLogs         OrderAuditLog[]
  stockReservations StockReservation[]

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([addressId], map: "Order_addressId_fkey")
}

model Shipment {
  id               String         @id @default(uuid())
  orderId          String         @unique
  courierPartner   String
  awbNumber        String?
  trackingUrl      String?
  status           ShipmentStatus @default(PROCESSING)
  type             ShipmentType   @default(FORWARD)
  rmaPickupId      String?        @unique
  rmaReplacementId String?        @unique
  dispatchedAt     DateTime?
  expectedBy       DateTime?
  deliveredAt      DateTime?
  notes            String?
  updatedAt        DateTime       @updatedAt
  order            Order          @relation(fields: [orderId], references: [id])
  rmaPickup        RMARequest?    @relation("PickupShipment", fields: [rmaPickupId], references: [id])
  rmaReplacement   RMARequest?    @relation("ReplacementShipment", fields: [rmaReplacementId], references: [id])

  @@index([orderId])
  @@index([status])
}

model Coupon {
  id            String        @id @default(uuid())
  code          String        @unique
  discountType  DiscountType
  discountValue Decimal       @db.Decimal(10, 2)
  minOrderValue Decimal?      @db.Decimal(10, 2)
  maxUsage      Int? // Global limit
  perUserLimit  Int?          @default(1) // Limit per user
  usedCount     Int           @default(0)
  validFrom     DateTime?
  expiresAt     DateTime?
  isActive      Boolean       @default(true)
  couponUsages  CouponUsage[]

  @@index([code])
  @@index([isActive])
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String
  userId    String
  usedCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@index([couponId])
  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique @db.VarChar(512)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId], map: "Wishlist_productId_fkey")
}

model StockReservation {
  id        String            @id @default(uuid())
  productId String
  orderId   String?
  userId    String?
  sessionId String?
  quantity  Int
  expiresAt DateTime
  status    ReservationStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  order     Order?            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([orderId])
  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
  @@index([status])
}

model OrderItem {
  id         String    @id @default(uuid())
  orderId    String
  productId  String
  quantity   Int
  unitPrice  Decimal   @db.Decimal(10, 2)
  gstPercent Float
  subtotal   Decimal   @db.Decimal(10, 2)
  Order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product   @relation(fields: [productId], references: [id])
  rmaItems   RMAItem[]

  @@index([orderId])
  @@index([productId])
  @@map("orderitem")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ShipmentStatus {
  PROCESSING
  DISPATCHED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RTO
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum ReservationStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  RELEASED
}

enum RMARequestType {
  RETURN
  REPLACEMENT
}

enum RMARequestStatus {
  PENDING
  APPROVED
  REJECTED
  PICKUP_SCHEDULED
  ITEM_RECEIVED
  REFUND_INITIATED
  REFUND_COMPLETED
  REPLACEMENT_SHIPPED
  COMPLETED
  CANCELLED
}

enum ReturnReason {
  DAMAGED
  WRONG_ITEM
  SIZE_ISSUE
  QUALITY_ISSUE
  NOT_AS_DESCRIBED
  OTHER
}

enum RefundMode {
  ORIGINAL_PAYMENT_METHOD
  BANK_ACCOUNT
  UPI
}

enum ShipmentType {
  FORWARD
  REVERSE
  REPLACEMENT
}

model RMARequest {
  id           String           @id @default(uuid())
  rmaNumber    String           @unique
  orderId      String
  userId       String
  type         RMARequestType
  status       RMARequestStatus @default(PENDING)
  reason       ReturnReason
  customerNote String?          @db.Text
  adminNote    String?          @db.Text
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  order               Order      @relation(fields: [orderId], references: [id])
  user                User       @relation(fields: [userId], references: [id])
  images              RMAImage[]
  items               RMAItem[]
  refund              Refund?
  pickupShipment      Shipment?  @relation("PickupShipment")
  replacementShipment Shipment?  @relation("ReplacementShipment")

  @@index([orderId])
  @@index([userId])
  @@index([status])
}

model RMAItem {
  id           String @id @default(uuid())
  rmaRequestId String
  orderItemId  String
  quantity     Int

  rmaRequest RMARequest @relation(fields: [rmaRequestId], references: [id], onDelete: Cascade)
  orderItem  OrderItem  @relation(fields: [orderItemId], references: [id])

  @@index([rmaRequestId])
  @@index([orderItemId])
}

model RMAImage {
  id           String @id @default(uuid())
  rmaRequestId String
  url          String

  rmaRequest RMARequest @relation(fields: [rmaRequestId], references: [id], onDelete: Cascade)

  @@index([rmaRequestId])
}

model Refund {
  id           String        @id @default(uuid())
  rmaRequestId String        @unique
  amount       Decimal       @db.Decimal(10, 2)
  mode         RefundMode
  paymentId    String?
  status       PaymentStatus @default(PENDING)
  bankDetails  String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  rmaRequest RMARequest @relation(fields: [rmaRequestId], references: [id], onDelete: Cascade)
}

model OrderAuditLog {
  id        String   @id @default(uuid())
  orderId   String
  userId    String?
  action    String
  fromState String?
  toState   String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([userId])
}
